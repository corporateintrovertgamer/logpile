{
  "name": "logpile",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop game library with local storefront scanning and catalog import",
  "author": "Corporate Introvert Gamer (Ritesh Soni)",
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "commonjs",
  "scripts": {
    "dev": "vite --port 5178",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron electron/main.cjs",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5178 && cross-env NODE_ENV=development electron electron/main.cjs --dev\"",
    "dist": "vite build && npx electron-builder --win"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.10",
    "adm-zip": "^0.5.18",
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.10.0",
    "clsx": "^2.1.1",
    "electron-window-state": "^5.0.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^2.6.0",
    "vdf-parser": "^1.2.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "electron": "^32.2.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "electron@32.3.3": true,
    "esbuild@0.21.5": true
  },
  "build": {
    "appId": "com.logpile.app",
    "productName": "Logpile",
    "copyright": "Copyright © 2026 Logpile by Corporate Introvert Gamer (Ritesh Soni)",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "extraFiles": [
      "LICENSE",
      "FONT_LICENSE_OFL.txt",
      "readme.txt"
    ],
    "files": [
      "app-dist/**/*",
      "electron/**/*",
      "src/main/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "include": "build/installer.nsh",
      "installerIcon": "build/installer-icon.ico",
      "installerHeaderIcon": "build/installer-icon.ico"
    }
  }
}
